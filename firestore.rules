rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userIdField) {
      return signedIn() && request.auth.uid == userIdField;
    }

    // ---- 반응 하루 상한 ----
    // 날짜 키는 서버 시각(request.time, UTC)에서만 뽑는다.
    // 클라이언트가 날짜를 조작해 새 쿼터 버킷을 만드는 걸 막기 위함.
    // lib/postsClient.ts의 reactionQuotaDay()와 형식이 같아야 한다.
    function utcDayKey() {
      return string(request.time.year()) + '-'
        + string(request.time.month()) + '-'
        + string(request.time.day());
    }

    // 익명 계정은 무한히 찍어낼 수 있으므로 상한을 더 낮게 둔다.
    // lib/postsClient.ts의 DAILY_REACTION_LIMIT* 와 값이 같아야 한다.
    function dailyReactionCap() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous' ? 40 : 120;
    }

    function myQuotaId() {
      return request.auth.uid + '_' + utcDayKey();
    }

    // 반응 생성은 같은 트랜잭션 안에서 쿼터가 증가해야만 통과한다.
    function reactionQuotaOk(uid) {
      let quota = getAfter(/databases/$(database)/documents/reaction_quota/$(uid + '_' + utcDayKey()));
      return quota != null
        && quota.data.uid == uid
        && quota.data.day == utcDayKey()
        && quota.data.count is int
        && quota.data.count <= dailyReactionCap();
    }

    match /reaction_quota/{quotaId} {
      allow read: if signedIn() && quotaId == myQuotaId();
      allow create: if signedIn()
        && quotaId == myQuotaId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == utcDayKey()
        && request.resource.data.count == 1;
      // 1씩만, 상한까지만 증가. 감소·초기화 불가.
      allow update: if signedIn()
        && quotaId == myQuotaId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == utcDayKey()
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= dailyReactionCap();
      allow delete: if false;
    }

    // ---- 게시물 ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.caption is string
        && request.resource.data.caption.size() > 0
        && request.resource.data.caption.size() < 256
        && (!('imageUrl' in request.resource.data)
            || request.resource.data.imageUrl == null
            || (request.resource.data.imageUrl is string
                && request.resource.data.imageUrl.size() < 800000));
      allow update, delete: if isOwner(resource.data.userId);

      // 반응: 유저당 1개 (docId == uid)
      match /reactions/{reactorId} {
        allow read: if true;
        // 새 반응은 하루 쿼터를 소모한다.
        allow create: if signedIn()
          && request.auth.uid == reactorId
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() < 32
          && reactionQuotaOk(reactorId);
        // 이미 누른 반응의 이모지 변경은 총량이 늘지 않으므로 쿼터를 쓰지 않는다.
        allow update: if signedIn()
          && request.auth.uid == reactorId
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() < 32;
        allow delete: if signedIn() && request.auth.uid == reactorId;
      }

      // 댓글: 이모지 전용 (길이 제한으로 텍스트 남용 억제)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isOwner(request.resource.data.user_id)
          && request.resource.data.emoji_comment is string
          && request.resource.data.emoji_comment.size() < 64;
        allow delete: if isOwner(resource.data.user_id);
      }
    }

    // ---- 프로필 (docId == uid) ----
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // ---- 팔로우 (docId == followerId_targetId) ----
    match /follows/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.followerId != request.resource.data.targetId
        && docId == request.auth.uid + '_' + request.resource.data.targetId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---- 미션 ----
    match /missions/{missionId} {
      allow read: if true;
      allow write: if false;
    }

    match /user_missions/{docId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /userMissions/{docId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // ---- 리더보드 (서버 전용 쓰기) ----
    match /leaderboardDaily/{docId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /leaderboardWeekly/{docId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---- 수익화 ----
    match /subscriptions/{docId} {
      allow read: if signedIn() && request.auth.uid == docId;
      allow write: if false;
    }

    match /info_reveals/{docId} {
      allow read: if isOwner(resource.data.viewerId);
      allow write: if false;
    }

    match /user_gifts/{docId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /gift_rate/{docId} {
      allow read, write: if false;
    }

    match /reveal_rate/{docId} {
      allow read, write: if false;
    }

    // ---- 리워드/스탬프 (본인 것만) ----
    match /user_stamps/{docId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
      allow update, delete: if false;
    }

    match /slot_ledger/{docId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
      allow update, delete: if false;
    }

    match /user_notifications/{docId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
      allow update, delete: if false;
    }

    // ---- FCM 토큰 ----
    match /fcm_tokens/{token} {
      allow read: if false;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ---- 관리자 (콘솔 전용) ----
    match /admin_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /admin_users/{docId} {
      allow read, write: if false;
    }

    match /mission_rejections/{docId} {
      allow read, write: if false;
    }

    match /post_rejections/{docId} {
      allow read, write: if false;
    }

    // ---- AGORA 에이전트 마켓 ----
    function isAgoraOperator() {
      return signedIn() && request.auth.token.email == 'specail6247@gmail.com';
    }

    match /agora_merchants/{merchantId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60
        && request.resource.data.basePrice is number
        && request.resource.data.basePrice >= 0
        && request.resource.data.basePrice <= 100000000;
      allow update, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAgoraOperator());
    }

    match /agora_requests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 300;
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAgoraOperator());
      allow delete: if isAgoraOperator();

      match /events/{eventId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() < 500;
        allow update, delete: if false;
      }

      match /offers/{offerId} {
        allow read: if true;
        allow create, update: if signedIn();
        allow delete: if false;
      }
    }

    match /agora_deals/{dealId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000000;
      allow update, delete: if isAgoraOperator();
    }

    match /agora_settings/{docId} {
      allow read: if true;
      allow write: if isAgoraOperator();
    }
  }
}
